# Dependencies, in every package (root, expo-app, server, shared)
node_modules/

# Misc
.DS_Store
*.pem

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs
*.njsproj
*.sln
*.sw?

# Log files
logs/
server/logs/
*.log


# Database dumps (contain real personal data — never committed)
server/backups/*.dump

# Generated interview sheets (npm run interviews:pdf)
docs/interviews/print/

# Completed interview records (contain real personal data — never committed)
docs/interviews/records/

# End-to-end test output
e2e/test-results/
e2e/.run.lock
e2e/.run.lock.mutex
e2e/report/
e2e/shots/

# MaxMind GeoLite2 databases (HOME-4): licensed per account, downloaded, never committed
*.mmdb
