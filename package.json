{
  "name": "sk",
  "version": "0.0.4",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "hooks:install": "git config core.hooksPath .githooks",
    "release": "commit-and-tag-version",
    "release:push": "npm run release && git push --follow-tags",
    "review:rugby": "node scripts/rugby-review.js",
    "interviews:pdf": "node scripts/interview-pdf.js",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:report": "playwright show-report e2e/report",
    "e2e:release": "node e2e/runLock.js release",
    "e2e:lock": "node e2e/runLock.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "commit-and-tag-version": "^12.6.1"
  }
}
