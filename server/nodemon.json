{
  "watch": ["src", "../shared/dist"],
  "ext": "ts,js,json",
  "ignore": [
    "**/node_modules/**",
    "../shared/node_modules/**",
    "src/scripts/*.ts",
    "src/scripts/migrations/**",
    "src/scripts/testHelpers/**",
    "src/scripts/setup/fixtures/**",
    "src/scripts/setup/seeds/**",
    "src/scripts/setup/init-db.ts",
    "src/scripts/setup/reset-db.ts",
    "src/scripts/setup/reset-test-orgs.ts",
    "src/scripts/setup/seed-db.ts",
    "src/scripts/setup/seedCore.ts",
    "src/scripts/setup/test-db.ts",
    "src/scripts/setup/README.md"
  ],
  "delay": "1000",
  "exec": "ts-node src/index.ts"
}
