PORT=3001

# DATABASE SETUP
DB_HOST=localhost
DB_NAME=sk
DB_PORT=5432
DB_USERNAME=sk_admin
DB_PASSWORD=scorekeeper

# Environment
NODE_ENV=development

# get_data authorization.
# Unset (or anything but "true") logs every refusal as `[DataAccess] WOULD-REFUSE` and
# blocks nothing. Turned on for the tournaments build so a new request type cannot be
# born unauthenticated — see docs/tournaments-implementation-plan.md Phase 0.
GET_DATA_ENFORCE=true

# SMTP CONFIGURATION
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user_email_here
SMTP_PASS=your_smtp_password_here

# Initial App Admin
INITIAL_ADMIN_EMAIL=appadmin@scorekeeper.live
INITIAL_ADMIN_PASSWORD=appadmin123

# Client App URL for links
APP_URL=http://localhost:8081

# UPLOADED IMAGES (MEDIA-1) — see src/services/assetStorage.ts
# Where logos and profile pictures are stored. Only "local" exists today.
ASSET_STORAGE=local
# Folder for local storage; relative paths resolve against this server package.
ASSET_LOCAL_DIR=public/uploads
# Where the app fetches images from, announced by GET /api/client-config. A path means this
# server serves them; a full URL (e.g. https://assets.example.com) means another server does.
ASSET_BASE_URL=/uploads

# HOME'S LOCATION (HOME-4) — see docs/home.md §3
# The server's guess at where a visitor is, from their connection: a MaxMind GeoLite2 City database
# (free account at maxmind.com). Unset, the guess is off and Home asks the visitor instead.
# A relative path resolves against the folder the server runs in (this one).
# GEOIP_CITY_DB=geoip/GeoLite2-City.mmdb
# Development only: a local connection has no answer in the database, so this stands in for it
# ("lat,lng,label"). Leave unset in production.
# HOME_APPROX_LOCATION=-25.85,28.19,Pretoria
